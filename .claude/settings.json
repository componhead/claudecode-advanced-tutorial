{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(src/**)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npx tsc *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit -p . || true"
          }
        ]
      }
    ]
  }
}
